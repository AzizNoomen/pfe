version: '3.8'

services:
    neo4j:
        image: neo4j:4.4
        environment:
        NEO4J_AUTH: "neo4j/password"
        ports:
        - "7474:7474"
        - "7687:7687"

    ingestion_service:
        build: .
        depends_on:
        - neo4j
        environment:
        - NEO4J_URI=bolt://neo4j:7687
        - NEO4J_USER=neo4j
        - NEO4J_PASSWORD=password
        ports:
        - "8000:80"
